---
import '@fontsource/reenie-beanie/400.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import '../styles/sky.css';
import { etudes, LETTERS, MINOR_LETTERS, PIGMENTS, keyIndex, pigment, short, clock } from '../lib/theory';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const site = Astro.site ?? new URL('https://www.theodoreoy.com');
const title = 'The Étude Sky';
const description =
  "Chopin's twenty-four études charted as stars on the circle of fifths, each with a plate drawn from its recording. Curated by Theodore Ouyang.";
const total = etudes.reduce((s, e) => s + e.duration, 0);

// The chart: position angle is the key around the circle of fifths, C at 0°;
// the outer ring holds major keys, the inner ring their relative minors.
// Stars are drawn by magnitude, as in a star atlas.
const C = 500;
const RING = { major: 330, minor: 205 };
const at = (k: number, r: number, along = 0) => {
  const a = (k / 12) * Math.PI * 2;
  return { x: C + Math.sin(a) * r + Math.cos(a) * along, y: C - Math.cos(a) * r + Math.sin(a) * along };
};
const groups = new Map<string, string[]>();
for (const e of etudes) {
  const g = `${keyIndex(e)}-${e.mode}`;
  groups.set(g, [...(groups.get(g) ?? []), e.id]);
}
const stars = etudes.map((e) => {
  const g = groups.get(`${keyIndex(e)}-${e.mode}`)!;
  const along = (g.indexOf(e.id) - (g.length - 1) / 2) * 44;
  const p = at(keyIndex(e), RING[e.mode], along);
  return { e, ...p, r: 6 + (4.6 - e.magnitude) * 5 };
});
const route = (op: number) =>
  stars
    .filter((s) => s.e.op === op)
    .map((s) => `${s.x.toFixed(1)},${s.y.toFixed(1)}`)
    .join(' ');
const arc = (k: number, r: number) => {
  const a0 = ((k - 0.42) / 12) * Math.PI * 2;
  const a1 = ((k + 0.42) / 12) * Math.PI * 2;
  return `M${C + Math.sin(a0) * r} ${C - Math.cos(a0) * r} A${r} ${r} 0 0 1 ${C + Math.sin(a1) * r} ${C - Math.cos(a1) * r}`;
};
const ticks = Array.from({ length: 60 }, (_, k) => k);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f0e3" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(base, site).href} />
    <meta property="og:image" content={new URL(`${base}og.jpg`, site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <main class="stage">
      <section class="sky-col" aria-label="The star chart">
        <figure class="chart">
          <svg id="sky" viewBox="0 0 1000 1000" role="group" aria-labelledby="sky-title">
            <title id="sky-title">Star chart of the twenty-four études on the circle of fifths</title>
            <defs>
              <filter id="wash" x="-50%" y="-50%" width="200%" height="200%">
                <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="3" seed="7" />
                <feDisplacementMap in="SourceGraphic" scale="14" />
                <feGaussianBlur stdDeviation="2.2" />
              </filter>
            </defs>
            <circle cx={C} cy={C} r={RING.major} class="ring" />
            <circle cx={C} cy={C} r={RING.minor} class="ring" />
            <circle cx={C} cy={C} r="440" class="ring" />
            <circle cx={C} cy={C} r="448" class="ring faint" />
            {ticks.map((k) => {
              const a = at(k, 440);
              const b = at(k, k % 5 === 0 ? 426 : 433);
              return <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} class={k % 5 === 0 ? 'tick major' : 'tick'} />;
            })}
            {LETTERS.map((_, k) => {
              const a = at(k, 112);
              const b = at(k, 372);
              return <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} class="spoke" />;
            })}
            {PIGMENTS.map((p, k) => <path d={arc(k, 384)} stroke={p} class="wheel" />)}
            {LETTERS.map((l, k) => {
              const p = at(k, 408);
              return <text x={p.x} y={p.y} dy="0.35em" class="key major">{l}</text>;
            })}
            {MINOR_LETTERS.map((l, k) => {
              const p = at(k, 150);
              return <text x={p.x} y={p.y} dy="0.35em" class="key minor">{l}</text>;
            })}
            <text x={C} y={C - 4} class="centre">circle</text>
            <text x={C} y={C + 26} class="centre">of fifths</text>
            <polyline points={route(10)} class="route op10" />
            <polyline points={route(25)} class="route op25" />
            <path id="trail" class="trail" d="" />
            {stars.map((s) => (
              <g
                class="star"
                data-id={s.e.id}
                tabindex="0"
                role="button"
                aria-label={`Op. ${s.e.op}, No. ${s.e.no}, ${s.e.key}${s.e.en ? `, ${s.e.en}` : ''}, magnitude ${s.e.magnitude}`}
                style={`--pigment:${pigment(s.e)}`}
              >
                <circle cx={s.x} cy={s.y} r={s.r * 2.3} class="halo" filter="url(#wash)" />
                <circle cx={s.x} cy={s.y} r={s.r + 9} class="select" />
                <circle cx={s.x} cy={s.y} r={s.r} class={`body ${s.e.mode}`} />
                <text x={s.x} y={s.y + s.r + 20} class="tag">{short(s.e)}</text>
              </g>
            ))}
          </svg>
          <div class="tip" id="tip" aria-hidden="true"></div>
        </figure>

        <nav class="sequence" aria-label="All études in order of publication">
          {[10, 25].map((op) => (
            <div class="row">
              <span class="row-label">Op. {op}</span>
              <ol>
                {etudes
                  .filter((e) => e.op === op)
                  .map((e) => (
                    <li>
                      <button type="button" data-goto={e.id} style={`--pigment:${pigment(e)}`} aria-label={`Op. ${e.op}, No. ${e.no}`}>
                        {e.no}
                      </button>
                    </li>
                  ))}
              </ol>
            </div>
          ))}
        </nav>

        <dl class="legend">
          <div><dt>position angle</dt><dd>the key on the circle of fifths: C at 0°, each fifth 30° clockwise</dd></div>
          <div><dt>ring</dt><dd>major keys outside; each relative minor inside, at the same angle</dd></div>
          <div><dt>magnitude</dt><dd>loudness of the recording on Pogson's scale, one magnitude to 4 dB; brighter stars are drawn larger</dd></div>
          <div><dt>colour</dt><dd>the key, read from the wheel around the chart</dd></div>
          <div><dt>multiple stars</dt><dd>études in the same key, one system: a triple in A minor, seven doubles</dd></div>
          <div><dt>asterisms</dt><dd><span class="sample solid"></span>Op. 10 · <span class="sample dashed"></span>Op. 25, each joined in order of publication</dd></div>
        </dl>
      </section>

      <div class="side">
        <header class="top">
          <div>
            <p class="eyebrow">Atelier · curated by <a href="https://www.theodoreoy.com/">Theodore Ouyang</a></p>
            <h1>{title}</h1>
            <p class="lede">
              Chopin's twenty-four études, charted as stars. Fifteen keys hold all twenty-four, so some are double stars and one is triple, and the
              order of publication traces two asterisms across the sky.
            </p>
          </div>
          <button type="button" class="link about-link" data-about>about</button>
        </header>

        <aside class="panel" id="panel" aria-live="polite">
          <section class="intro" id="intro">
            <figure class="epigraph">
              <blockquote>
                <p lang="en">Nature always wears the colors of the spirit.</p>
                <p lang="zh-Hans" class="zh-line">自然总披着心灵的色彩。</p>
              </blockquote>
              <figcaption>Ralph Waldo Emerson, <cite>Nature</cite> (1836), chapter I</figcaption>
            </figure>
            <p>
              When I look up at the night sky, I think of Chopin's études. This chart is the picture that forms in my mind. Choose a star to see its
              plate and hear it, or begin at the beginning and let the cycle play through, {Math.round(total / 60)} minutes in order of publication.
            </p>
            <div class="actions">
              <button type="button" class="primary" data-begin>Begin with Op. 10, No. 1</button>
            </div>
            <p class="note">
              Read the asterisms. Op. 10 is built mostly from pairs in relative keys, so its line keeps stepping straight from the outer ring to the
              inner. Op. 25 moves more freely, often by mediant, a third at a time.
            </p>
          </section>

          <article class="etude" id="etude" hidden>
            <figure class="plate">
              <button type="button" class="plate-open" id="plate-open" aria-label="Open the plate at full size">
                <img id="plate-img" alt="" width="1500" height="1500" />
                <canvas id="plate-live" aria-hidden="true"></canvas>
              </button>
            </figure>
            <p class="ident" id="ident"></p>
            <h2 class="script" id="name"></h2>
            <p class="zh" id="zh" lang="zh-Hans"></p>
            <dl class="facts" id="facts"></dl>
            <section class="relations">
              <h3>Its neighbours in the sky</h3>
              <ul id="relations"></ul>
            </section>
            <details class="reading">
              <summary>How the plate is drawn</summary>
              <p>
                A polar plot of the recording. Position angle is pitch class, read from a chromagram and placed on the circle of fifths; radial
                distance is elapsed time. Each point is a note onset, found by spectral flux and drawn larger the stronger the attack. Every pitch class
                keeps its colour from the wheel, laid where and when it sounds, deeper where the music is louder. Gold marks the strongest onsets,
                joined by a minimum spanning tree.
              </p>
            </details>
            <div class="step">
              <button type="button" class="link" data-step="-1">← previous</button>
              <button type="button" class="link" data-step="1">next →</button>
            </div>
          </article>
        </aside>
      </div>
    </main>

    <footer class="player" id="player">
      <div class="transport">
        <button type="button" data-step="-1" aria-label="Previous étude">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5v14M19 5 9 12l10 7z" /></svg>
        </button>
        <button type="button" class="play" id="play" aria-label="Play">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-play"><path d="M8 5v14l11-7z" /></svg>
          <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-pause"><path d="M8 5v14M16 5v14" /></svg>
        </button>
        <button type="button" data-step="1" aria-label="Next étude">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 5v14M5 5l10 7-10 7z" /></svg>
        </button>
      </div>
      <div class="now">
        <p><span id="now-title">Op. 10 · No. 1</span><span class="now-name" id="now-name">Waterfall</span></p>
        <div class="bar" id="bar" role="slider" tabindex="0" aria-label="Position in the étude" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <i id="bar-fill"></i>
        </div>
        <span class="time" id="time">0:00 / {clock(etudes[0].duration)}</span>
      </div>
      <label class="cycle"><input type="checkbox" id="cycle" checked /> continue through the cycle</label>
    </footer>

    <dialog class="about" id="about" aria-labelledby="about-title">
      <button type="button" class="link close" data-close>close</button>
      <h2 class="script" id="about-title">About</h2>
      <p>
        When I look up at the stars, I think of Chopin's twenty-four études. This sky is the picture that forms in my mind: each étude a star,
        placed by its key, and each a plate drawn from the music itself. Someone else, looking up, would see another sky.
      </p>
      <figure class="epigraph">
        <blockquote>
          <p lang="en">Nature always wears the colors of the spirit.</p>
          <p lang="zh-Hans" class="zh-line">自然总披着心灵的色彩。</p>
        </blockquote>
        <figcaption>Ralph Waldo Emerson, <cite>Nature</cite> (1836), chapter I; Chinese translation mine</figcaption>
      </figure>
      <p>
        Emerson opens that chapter by asking his reader to look at the stars, and closes it by noticing that the same landscape can look different to
        the same person from one day to the next. So it is with this sky.
      </p>
      <dl class="credits">
        <div><dt>music</dt><dd>Frédéric Chopin, 12 Études, Op. 10 (1833) and 12 Études, Op. 25 (1837)</dd></div>
        <div><dt>recordings</dt><dd>Edward Neeman, piano; recorded for Musopen's Set Chopin Free (2014), public domain; loudness-matched</dd></div>
        <div><dt>method</dt><dd>Chromagram for pitch class, spectral flux for onsets, gated loudness for magnitude on Pogson's scale</dd></div>
        <div><dt>plates</dt><dd>Polar plots of each recording, in watercolour and gold</dd></div>
        <div><dt>curated by</dt><dd><a href="https://www.theodoreoy.com/">Theodore Ouyang</a></dd></div>
      </dl>
    </dialog>

    <dialog class="lightbox" id="lightbox" aria-label="Plate at full size">
      <button type="button" class="link close" data-close>close</button>
      <img id="lightbox-img" alt="" />
    </dialog>

    <script>
      import { start } from '../scripts/sky';
      start();
    </script>
  </body>
</html>

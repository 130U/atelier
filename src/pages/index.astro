---
import '@fontsource/nothing-you-could-do/400.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import '../styles/sky.css';
import { etudes, LETTERS, MINOR_LETTERS, PIGMENTS, keyIndex, pigment, short, clock, nameOf } from '../lib/theory';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const site = Astro.site ?? new URL('https://www.theodoreoy.com');
const title = 'The Étude Sky';
const description =
  "Chopin's twenty-four études charted as stars on the circle of fifths, with a plate drawn from each recording and a handscroll in watercolour that unrolls as you listen. Curated by Theodore Ouyang.";
const total = etudes.reduce((s, e) => s + e.duration, 0);

// The chart: position angle is the key around the circle of fifths, C at 0°;
// major keys on the outer ring, their relative minors on the inner ring.
// Stars are drawn by magnitude, as in a star atlas.
const C = 500;
const RING = { major: 332, minor: 214 };
const at = (k: number, r: number, along = 0) => {
  const a = (k / 12) * Math.PI * 2;
  return { x: C + Math.sin(a) * r + Math.cos(a) * along, y: C - Math.cos(a) * r + Math.sin(a) * along };
};
const groups = new Map<string, string[]>();
for (const e of etudes) {
  const g = `${keyIndex(e)}-${e.mode}`;
  groups.set(g, [...(groups.get(g) ?? []), e.id]);
}
const stars = etudes.map((e) => {
  const g = groups.get(`${keyIndex(e)}-${e.mode}`)!;
  const along = (g.indexOf(e.id) - (g.length - 1) / 2) * 42;
  const p = at(keyIndex(e), RING[e.mode], along);
  return { e, ...p, r: 5 + (4.6 - e.magnitude) * 4.4 };
});
const route = (op: number) =>
  stars
    .filter((s) => s.e.op === op)
    .map((s) => `${s.x.toFixed(1)},${s.y.toFixed(1)}`)
    .join(' ');
const arc = (k: number, r: number) => {
  const a0 = ((k - 0.4) / 12) * Math.PI * 2;
  const a1 = ((k + 0.4) / 12) * Math.PI * 2;
  return `M${C + Math.sin(a0) * r} ${C - Math.cos(a0) * r} A${r} ${r} 0 0 1 ${C + Math.sin(a1) * r} ${C - Math.cos(a1) * r}`;
};
const ticks = Array.from({ length: 60 }, (_, k) => k);
const pad = (n: number) => String(n).padStart(2, '0');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f2ea" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(base, site).href} />
    <meta property="og:image" content={new URL(`${base}og.jpg`, site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="masthead">
      <a class="mark" href="https://www.theodoreoy.com/">Theodore Ouyang</a>
      <nav aria-label="Sections">
        <a href="#sky">Sky</a>
        <a href="#plates">Plates</a>
        <a href="#notes">Notes</a>
      </nav>
    </header>

    <main>
      <section class="hero" id="sky" aria-label="The star chart">
        <div class="hero-grid">
          <figure class="chart">
            <svg id="chart" viewBox="0 0 1000 1000" role="group" aria-labelledby="chart-title">
              <title id="chart-title">The twenty-four études charted on the circle of fifths</title>
              <defs>
                <filter id="wash" x="-60%" y="-60%" width="220%" height="220%">
                  <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="3" seed="11" />
                  <feDisplacementMap in="SourceGraphic" scale="12" />
                  <feGaussianBlur stdDeviation="2" />
                </filter>
              </defs>
              <circle cx={C} cy={C} r="446" class="ring outer" />
              <circle cx={C} cy={C} r={RING.major} class="ring" />
              <circle cx={C} cy={C} r={RING.minor} class="ring" />
              {ticks.map((k) => {
                const a = at(k, 446);
                const b = at(k, k % 5 === 0 ? 432 : 439);
                return <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} class={k % 5 === 0 ? 'tick major' : 'tick'} />;
              })}
              {PIGMENTS.map((p, k) => <path d={arc(k, 388)} stroke={p} class="wheel" />)}
              {LETTERS.map((l, k) => {
                const p = at(k, 412);
                return <text x={p.x} y={p.y} dy="0.36em" class="key major">{l}</text>;
              })}
              {MINOR_LETTERS.map((l, k) => {
                const p = at(k, 172);
                return <text x={p.x} y={p.y} dy="0.36em" class="key minor">{l}</text>;
              })}
              <polyline points={route(10)} class="route op10" />
              <polyline points={route(25)} class="route op25" />
              <path id="trail" class="trail" d="" />
              {stars.map((s) => (
                <g
                  class="star"
                  data-id={s.e.id}
                  data-x={s.x.toFixed(1)}
                  data-y={s.y.toFixed(1)}
                  tabindex="0"
                  role="button"
                  aria-label={`Op. ${s.e.op}, No. ${s.e.no}, ${s.e.key}${s.e.en ? `, ${s.e.en}` : ''}, magnitude ${s.e.magnitude}`}
                  style={`--pigment:${pigment(s.e)}`}
                >
                  <circle cx={s.x} cy={s.y} r={s.r * 2.4} class="halo" filter="url(#wash)" />
                  <circle cx={s.x} cy={s.y} r={s.r + 8} class="select" />
                  <circle cx={s.x} cy={s.y} r={s.r} class={`body ${s.e.mode}`} />
                  <text x={s.x} y={s.y + s.r + 18} class="tag">{short(s.e)}</text>
                </g>
              ))}
            </svg>
            <div class="tip" id="tip" aria-hidden="true"></div>
          </figure>

          <div class="aside" aria-live="polite">
            <section class="intro" id="intro">
              <p class="kicker">Chopin · Études Op. 10 &amp; Op. 25</p>
              <h1>{title}</h1>
              <p class="lede">
                Twenty-four études, charted as stars on the circle of fifths. Fifteen keys hold all twenty-four, so some stars are double and one is
                triple, and the order of publication traces two asterisms across the sky.
              </p>
              <blockquote class="quote">
                <p>“Nature always wears the colors of the spirit.”</p>
                <footer>Ralph Waldo Emerson, <cite>Nature</cite>, 1836</footer>
              </blockquote>
              <div class="actions">
                <button type="button" class="button" data-begin>Begin with Op. 10, No. 1</button>
                <span class="hint">the full cycle · {Math.round(total / 60)} min</span>
              </div>
            </section>

            <article class="card" id="card" hidden>
              <p class="kicker" id="card-ident"></p>
              <h2 id="card-name"></h2>
              <p class="card-key" id="card-key"></p>
              <dl class="entry" id="card-entry"></dl>
              <ul class="neighbours" id="card-neighbours"></ul>
              <div class="card-links">
                <button type="button" class="text-link" id="card-plate">View the plate</button>
                <span class="step">
                  <button type="button" class="text-link" data-step="-1" aria-label="Previous étude">←</button>
                  <button type="button" class="text-link" data-step="1" aria-label="Next étude">→</button>
                </span>
              </div>
            </article>
          </div>
        </div>
        <figure class="scroll" aria-labelledby="scroll-title">
          <figcaption class="scroll-head">
            <span id="scroll-title">Handscroll</span>
            <span id="scroll-note"></span>
          </figcaption>
          <div class="scroll-paper">
            <ol class="scroll-rows" aria-hidden="true">
              {LETTERS.map((l, k) => (
                <li style={`--pigment:${PIGMENTS[k]}`}><span>{l}</span></li>
              ))}
            </ol>
            <div class="scroll-sheet">
              <canvas id="scroll-a" class="on" aria-hidden="true"></canvas>
              <canvas id="scroll-b" aria-hidden="true"></canvas>
              <i class="playhead" id="playhead"></i>
            </div>
          </div>
        </figure>
      </section>

      <section class="plates" id="plates" aria-labelledby="plates-title">
        <div class="section-head">
          <p class="kicker">The plates</p>
          <h2 id="plates-title">Twenty-four polar plots</h2>
          <p>
            Each plate is drawn from its recording by one set of rules. Position angle is pitch class on the circle of fifths; distance from the centre
            is time; every point is a note as it is struck. Each pitch class keeps its colour from the wheel, laid where and when it sounds, and gold
            joins the strongest notes.
          </p>
        </div>
        <ol class="grid">
          {etudes.map((e) => (
            <li>
              <button type="button" class="plate-tile" data-plate={e.id}>
                <img src={`${base}plates/thumb/${e.id}.jpg`} alt={`Plate for Op. ${e.op}, No. ${e.no} in ${e.key}`} loading="lazy" width="520" height="520" />
                <span class="tile-ident">Op. {e.op} · No. {pad(e.no)}</span>
                <span class="tile-name">{nameOf(e)}</span>
                <span class="tile-key">{e.key} · mag {e.magnitude.toFixed(1)} · {clock(e.duration)}</span>
              </button>
            </li>
          ))}
        </ol>
      </section>

      <section class="notes" id="notes" aria-labelledby="notes-title">
        <div class="notes-head">
          <p class="kicker">Notes</p>
          <h2 id="notes-title">A sky of my own</h2>
        </div>
        <div class="notes-body">
          <p>
            When I look up at the night sky, I think of Chopin's études. This chart is the picture that forms in my mind: each étude a star, placed
            by its key, and each a plate drawn from the music itself. Someone else, looking up, would see another sky.
          </p>
          <p>
            Beneath the chart, each étude is written out as a handscroll. Its twelve rows are the circle of fifths laid flat, and time runs from left
            to right, as in a piano roll. Every note is a stroke of watercolour in the colour of its pitch on the wheel, pressed where the key is
            struck and thinning as the string dies away. The scroll unrolls with the music, so each stroke appears as its note sounds; what is still
            to come shows faintly, like the underdrawing in a copybook. A key reads as a band of neighbouring rows, and a change of key as that band
            moving. The paper is laid by the true solar time at which you arrive, so no two visits are painted quite alike.
          </p>
          <figure class="epigraph">
            <blockquote><p>“Nature always wears the colors of the spirit.”</p></blockquote>
            <figcaption>Ralph Waldo Emerson, <cite>Nature</cite> (1836), chapter I</figcaption>
          </figure>
          <p>
            Emerson opens that chapter by asking his reader to look at the stars, and closes it by noticing that the same landscape can look different
            to the same person from one day to the next.
          </p>
          <figure class="epigraph">
            <blockquote><p>“I look at things through myself, and so all things wear my colours.”</p></blockquote>
            <figcaption>Wang Guowei, <cite>Renjian cihua</cite> (1908)</figcaption>
          </figure>

          <h3>Reading the sky</h3>
          <dl class="glossary">
            <div><dt>Position angle</dt><dd>The key on the circle of fifths: C at 0°, each fifth 30° clockwise.</dd></div>
            <div><dt>Ring</dt><dd>Major keys on the outer ring; each relative minor on the inner ring, at the same angle.</dd></div>
            <div><dt>Magnitude</dt><dd>The loudness of the recording on Pogson's scale, one magnitude to 4 dB. Brighter stars are drawn larger.</dd></div>
            <div><dt>Multiple stars</dt><dd>Études in the same key, drawn as one system: a triple in A minor and seven doubles.</dd></div>
            <div><dt>Handscroll</dt><dd>A chromagram: time across, from the first note to the last; pitch class down, in the order of the circle of fifths, C at the top. Each stroke is a note, as broad as it was struck and fading as it decays. Touch the scroll to move to that moment.</dd></div>
            <div><dt>Asterisms</dt><dd>Op. 10, solid, and Op. 25, dashed, each joined in order of publication. Op. 10 is built mostly from pairs in relative keys; Op. 25 moves more often by a third.</dd></div>
          </dl>

          <h3>Credits</h3>
          <dl class="glossary">
            <div><dt>Music</dt><dd>Frédéric Chopin, 12 Études, Op. 10 (1833) and 12 Études, Op. 25 (1837).</dd></div>
            <div><dt>Recordings</dt><dd>Edward Neeman, piano, recorded for Musopen's <cite>Set Chopin Free</cite> (2014). Public domain; loudness-matched.</dd></div>
            <div><dt>Method</dt><dd>A chromagram for pitch class, spectral flux for onsets, gated loudness for magnitude.</dd></div>
            <div><dt>Curator</dt><dd><a href="https://www.theodoreoy.com/">Theodore Ouyang</a></dd></div>
          </dl>
        </div>
      </section>
    </main>

    <footer class="player" id="player">
      <div class="transport">
        <button type="button" data-step="-1" aria-label="Previous étude">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 6v12M18 6l-8 6 8 6z" /></svg>
        </button>
        <button type="button" class="play" id="play" aria-label="Play">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-play"><path d="M9 6.5v11l9-5.5z" /></svg>
          <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-pause"><path d="M9 6v12M15 6v12" /></svg>
        </button>
        <button type="button" data-step="1" aria-label="Next étude">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 6v12M6 6l8 6-8 6z" /></svg>
        </button>
      </div>
      <p class="now"><span class="now-ident" id="now-ident">Op. 10 · No. 01</span><span class="now-name" id="now-name">Waterfall</span></p>
      <div class="bar" id="bar" role="slider" tabindex="0" aria-label="Position in the étude" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <i id="bar-fill"></i>
      </div>
      <span class="time" id="time">0:00 / {clock(etudes[0].duration)}</span>
      <ol class="index" aria-label="All études">
        {[10, 25].map((op) => (
          <li class="index-op">
            <span>{op}</span>
            {etudes
              .filter((e) => e.op === op)
              .map((e) => (
                <button type="button" data-goto={e.id} aria-label={`Op. ${e.op}, No. ${e.no}`}>{e.no}</button>
              ))}
          </li>
        ))}
      </ol>
      <label class="cycle" title="Continue through the cycle"><input type="checkbox" id="cycle" checked /><span>cycle</span></label>
    </footer>

    <dialog class="viewer" id="viewer" aria-labelledby="viewer-name">
      <button type="button" class="text-link close" data-close>Close</button>
      <div class="viewer-body">
        <figure class="viewer-plate">
          <img id="viewer-img" alt="" width="1500" height="1500" />
          <canvas id="viewer-live" aria-hidden="true"></canvas>
        </figure>
        <div class="viewer-text">
          <p class="kicker" id="viewer-ident"></p>
          <h2 id="viewer-name"></h2>
          <p class="card-key" id="viewer-key"></p>
          <div class="viewer-actions">
            <button type="button" class="button" id="viewer-play">Listen</button>
          </div>
          <div class="viewer-step">
            <button type="button" class="text-link" data-view-step="-1">← Previous plate</button>
            <button type="button" class="text-link" data-view-step="1">Next plate →</button>
          </div>
        </div>
      </div>
    </dialog>

    <script>
      import { start } from '../scripts/sky';
      start();
    </script>
  </body>
</html>
